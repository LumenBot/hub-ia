# Copie ce fichier en `rag/code/.env` (gitignored) et renseigne les clés.
# Chargé automatiquement par `rag/code/_env.py` à l'import des scripts
# ingest.py, query.py et run_eval.py (S1ter Lot S1c.1).

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
RAG_VECTOR_STORE_PATH=rag/code/vector_store
RAG_CONTENT_PATH=rag/content
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_GEN_MODEL=claude-sonnet-4-6
